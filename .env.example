# Copy this file to .env.local (which is git-ignored) and fill in real values
# to point the dashboard at a live Google Sheet instead of sample data.
#
# See README.md -> "Connecting to Google Sheets" for full setup steps.

# The long ID from the sheet's URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
VITE_SHEET_ID=

# The "gid" query param for each tab, visible in the URL after clicking that tab.
# Leads is required; Campaigns and Weekly Reviews are optional.
VITE_LEADS_GID=0
VITE_CAMPAIGNS_GID=
VITE_WEEKLY_REVIEWS_GID=
